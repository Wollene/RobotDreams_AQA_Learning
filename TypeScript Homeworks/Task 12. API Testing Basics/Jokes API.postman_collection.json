  "item": [
    {
      "name": "Get Random Joke",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const respBody = pm.response.json();\r",
              "\r",
              "pm.test(\"Request is successful. Status Code: 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"'Type' exists and is a string\", function () {\r",
              "    pm.expect(respBody.type).to.exist;\r",
              "    pm.expect(respBody.type).to.be.a('string');\r",
              "});\r",
              "\r",
              "pm.test(\"'Setup' exists and is a string\", function () {\r",
              "    pm.expect(respBody.setup).to.exist;\r",
              "    pm.expect(respBody.setup).to.be.a('string');\r",
              "});\r",
              "\r",
              "pm.test(\"'Punchline' exists and is a string\", function () {\r",
              "    pm.expect(respBody.punchline).to.exist;\r",
              "    pm.expect(respBody.punchline).to.be.a('string');\r",
              "});\r",
              "\r",
              "pm.test(\"'id' exists and is a number\", function () {\r",
              "    pm.expect(respBody.id).to.exist;\r",
              "    pm.expect(respBody.id).to.be.a('number');\r",
              "});\r",
              "\r",
              "pm.environment.set(\"jokeId\", respBody.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://official-joke-api.appspot.com/random_joke",
          "protocol": "https",
          "host": [
            "official-joke-api",
            "appspot",
            "com"
          ],
          "path": [
            "random_joke"
          ]
        }
      },
      "response": []
    },
